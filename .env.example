# Copy to .env and fill in. .env is gitignored, so the key never gets committed.
# No quotes needed. Any OpenAI-compatible provider works.

# xAI Grok
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=xai-your-key-here
# Run `python3 triage.py --list-models` to see the ids your key can use, then paste one here.
LLM_MODEL=

# Google Gemini (free tier) instead:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
